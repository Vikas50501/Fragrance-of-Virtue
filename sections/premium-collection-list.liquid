{%- render 'section-spacing-collapsing' -%}

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
PREMIUM COLLECTION LIST — CSS
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  /* ── Section wrapper ── */
  #shopify-section-{{ section.id }} .pcl-wrapper {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .pcl-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 10% 40%, rgba({{ section.settings.accent_color | color_extract: 'red' }}, {{ section.settings.accent_color | color_extract: 'green' }}, {{ section.settings.accent_color | color_extract: 'blue' }}, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 90% 60%, rgba({{ section.settings.accent_color | color_extract: 'red' }}, {{ section.settings.accent_color | color_extract: 'green' }}, {{ section.settings.accent_color | color_extract: 'blue' }}, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  /* ── Header ── */
  #shopify-section-{{ section.id }} .pcl-header {
    text-align: center;
    margin-bottom: 48px;
    position: relative;
    z-index: 1;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .pcl-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .pcl-ornament span {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: {{ section.settings.accent_color }};
    transform: rotate(45deg);
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .pcl-ornament span:nth-child(2) {
    width: 7px;
    height: 7px;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .pcl-subheading {
    font-family: var(--heading-font-family);
    font-size: 32px;
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pcl-heading {
    font-family: var(--heading-font-family);
    font-size: 32px;
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    line-height: 1.15;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .pcl-heading {
      font-size: 28px;
    }
  }

  #shopify-section-{{ section.id }} .pcl-divider {
    width: 60px;
    height: 2px;
    background: {{ section.settings.accent_color }};
    margin: 0 auto 18px;
    border: none;
  }

  #shopify-section-{{ section.id }} .pcl-description {
    font-family: var(--text-font-family);
    font-size: var(--text-base, 16px);
    font-weight: var(--text-font-weight);
    font-style: var(--text-font-style);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
    opacity: 0.65;
  }

  /* ── Grid ── */
  #shopify-section-{{ section.id }} .pcl-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.collections_per_row }}, 1fr);
    gap: 28px;
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--container-gutter, 20px);
    position: relative;
    z-index: 1;
  }

  /* ── Card ── */
  #shopify-section-{{ section.id }} .pcl-card {
    text-align: center;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 16px 24px;
    border-radius: 16px;
    transition:
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  {%- if section.settings.card_style == 'elevated' -%}
    #shopify-section-{{ section.id }} .pcl-card {
      background: #fff;
      box-shadow: 0 1px 6px rgba(0,0,0,0.04), 0 4px 20px rgba(0,0,0,0.05);
    }
  {%- endif -%}

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .pcl-card:hover {
      transform: translateY(-8px);
      {%- if section.settings.card_style == 'elevated' -%}
        box-shadow: 0 8px 30px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.06);
      {%- else -%}
        box-shadow: 0 6px 24px rgba(0,0,0,0.08);
      {%- endif -%}
    }
  }

  /* ── Circular image ── */
  #shopify-section-{{ section.id }} .pcl-image-wrap {
    --pcl-img: 150px;
    width: var(--pcl-img);
    height: var(--pcl-img);
    margin: 0 auto 18px;
    border-radius: 50%;
    border: 3px solid {{ section.settings.accent_color }};
    padding: 5px;
    box-sizing: border-box;
    transition: box-shadow 0.4s ease;
    flex-shrink: 0;
  }

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .pcl-card:hover .pcl-image-wrap {
      box-shadow:
        0 0 0 4px rgba({{ section.settings.accent_color | color_extract: 'red' }}, {{ section.settings.accent_color | color_extract: 'green' }}, {{ section.settings.accent_color | color_extract: 'blue' }}, 0.15),
        0 4px 20px rgba({{ section.settings.accent_color | color_extract: 'red' }}, {{ section.settings.accent_color | color_extract: 'green' }}, {{ section.settings.accent_color | color_extract: 'blue' }}, 0.18);
    }
  }

  #shopify-section-{{ section.id }} .pcl-image-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: #f0eeec;
  }

  #shopify-section-{{ section.id }} .pcl-image-inner img,
  #shopify-section-{{ section.id }} .pcl-image-inner svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .pcl-card:hover .pcl-image-inner img,
    #shopify-section-{{ section.id }} .pcl-card:hover .pcl-image-inner svg {
      transform: scale(1.10);
    }
  }

  /* ── Title ── */
  #shopify-section-{{ section.id }} .pcl-title {
    font-family: var(--heading-font-family);
    font-size: 15px;
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
    margin: 0 0 5px;
    letter-spacing: 0;
    line-height: 1.3;
  }

  /* ── Product count ── */
  #shopify-section-{{ section.id }} .pcl-count {
    font-family: var(--text-font-family);
    font-size: 12px;
    font-weight: var(--text-font-weight);
    opacity: 0.5;
    margin: 0 0 14px;
    line-height: 1.4;
  }

  /* ── CTA ── */
  #shopify-section-{{ section.id }} .pcl-cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--text-font-family);
    font-size: 11px;
    font-weight: 600;
    color: {{ section.settings.accent_color }};
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-top: auto;
    padding-top: 4px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .pcl-cta-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
    font-size: 13px;
    line-height: 1;
  }

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .pcl-card:hover .pcl-cta-arrow {
      transform: translateX(4px);
    }
  }

  #shopify-section-{{ section.id }} .pcl-cta::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: {{ section.settings.accent_color }};
    transition: width 0.35s ease;
  }

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .pcl-card:hover .pcl-cta::after {
      width: calc(100% - 18px);
    }
  }

  /* ── Footer link ── */
  #shopify-section-{{ section.id }} .pcl-footer {
    text-align: center;
    margin-top: 40px;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .pcl-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 32px;
    border: 2px solid {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    text-decoration: none;
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    border-radius: 50px;
    line-height: 1;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .pcl-view-all:hover {
      background: {{ section.settings.accent_color }};
      color: #fff;
      transform: translateY(-2px);
    }
  }

  /* ── Responsive — tablet ── */
  @media screen and (min-width: 700px) and (max-width: 999px) {
    #shopify-section-{{ section.id }} .pcl-wrapper {
      padding: 60px 0;
    }
    #shopify-section-{{ section.id }} .pcl-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
    #shopify-section-{{ section.id }} .pcl-image-wrap {
      --pcl-img: 130px;
    }
    #shopify-section-{{ section.id }} .pcl-header {
      margin-bottom: 36px;
    }
    #shopify-section-{{ section.id }} .pcl-subheading {
      font-size: 28px;
    }
  }

  /* ── Responsive — mobile ── */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .pcl-subheading {
      font-size: 28px;
    }
    #shopify-section-{{ section.id }} .pcl-wrapper {
      padding: 48px 0;
    }
    #shopify-section-{{ section.id }} .pcl-header {
      margin-bottom: 28px;
    }
    #shopify-section-{{ section.id }} .pcl-grid {
      grid-template-columns: repeat({{ section.settings.collections_per_row_mobile }}, 1fr);
      gap: 12px;
      padding: 0 16px;
    }
    #shopify-section-{{ section.id }} .pcl-card {
      padding: 20px 10px 18px;
      border-radius: 12px;
    }
    #shopify-section-{{ section.id }} .pcl-image-wrap {
      --pcl-img: 90px;
      border-width: 2.5px;
      padding: 4px;
      margin-bottom: 12px;
    }
    #shopify-section-{{ section.id }} .pcl-title {
      font-size: 13px;
      line-height: 1.25;
    }
    #shopify-section-{{ section.id }} .pcl-count {
      font-size: 11px;
      margin-bottom: 10px;
    }
    #shopify-section-{{ section.id }} .pcl-cta {
      font-size: 10px;
      letter-spacing: 0.8px;
    }
    #shopify-section-{{ section.id }} .pcl-footer {
      margin-top: 28px;
    }
    #shopify-section-{{ section.id }} .pcl-view-all {
      font-size: 11px;
      letter-spacing: 1px;
      padding: 10px 24px;
    }
  }
</style>

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
PREMIUM COLLECTION LIST — HTML
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<div {% render 'section-properties' %}>
  <div class="pcl-wrapper">

    {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
      <div class="pcl-header">
        <div class="pcl-ornament" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>

        {%- if section.settings.subheading != blank -%}
          <p class="pcl-subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="pcl-heading" {% if settings.heading_apparition != 'none' %}reveal-on-scroll="true"{% endif %}>
            {%- render 'styled-text', content: section.settings.title, text_color: section.settings.heading_color, gradient: section.settings.heading_gradient, apparition_effect: true -%}
          </h2>
        {%- endif -%}

        <hr class="pcl-divider" aria-hidden="true">

        {%- if section.settings.content != blank -%}
          <div class="pcl-description">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pcl-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign collection_url = block.settings.url | default: collection.url -%}
        {%- assign image = block.settings.image | default: collection.featured_image -%}

        <a {% if collection_url != blank %}href="{{ collection_url }}"{% endif %} class="pcl-card" {{ block.shopify_attributes }}>
          <div class="pcl-image-wrap">
            <div class="pcl-image-inner">
              {%- if image != blank -%}
                {%- capture sizes -%}(max-width: 699px) 90px, (max-width: 999px) 130px, 150px{%- endcapture -%}
                {{- image | image_url: width: image.width | image_tag: loading: 'lazy', sizes: sizes, widths: '180,260,300,400,500', class: '' -}}
              {%- else -%}
                {%- capture collection_placeholder -%}{% cycle 'collection-1', 'collection-2', 'collection-3' %}{%- endcapture -%}
                {{- collection_placeholder | placeholder_svg_tag: 'placeholder' -}}
              {%- endif -%}
            </div>
          </div>

          <p class="pcl-title">{{ block.settings.title | default: collection.title | escape }}</p>

          {%- if section.settings.show_product_count and collection != blank and collection.all_products_count > 0 -%}
            <p class="pcl-count">{{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'Product', 'Products' }}</p>
          {%- endif -%}

          {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
            <span class="pcl-cta">
              {{ section.settings.cta_text | escape }}
              <span class="pcl-cta-arrow" aria-hidden="true">&#8594;</span>
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.link_text != blank -%}
      <div class="pcl-footer">
        <a href="{{ section.settings.link_url }}" class="pcl-view-all">
          {{ section.settings.link_text | escape }}
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Premium Collection List",
  "class": "shopify-section--premium-collection-list",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "collections_per_row",
      "min": 2,
      "max": 6,
      "label": "Collections per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "collections_per_row_mobile",
      "label": "Collections per row (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "elevated", "label": "Elevated card" },
        { "value": "flat", "label": "Flat (no card)" }
      ],
      "default": "elevated"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show call-to-action",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated For You"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View all link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "View all link text"
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Gradient replaces solid colors when set."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / border color",
      "default": "#c41e3a"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square image recommended. Defaults to collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "info": "Defaults to collection title."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Defaults to collection URL."
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading style",
          "options": [
            { "value": "h1", "label": "X-Large" },
            { "value": "h2", "label": "Large" },
            { "value": "h3", "label": "Medium" },
            { "value": "h4", "label": "Small" },
            { "value": "h5", "label": "X-Small" },
            { "value": "h6", "label": "XX-Small" }
          ],
          "default": "h3"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Legacy: content position",
          "options": [
            { "value": "place-self-start text-start", "label": "Top left" },
            { "value": "place-self-center text-center", "label": "Middle center" },
            { "value": "place-self-end-center text-center", "label": "Bottom center" }
          ],
          "default": "place-self-center text-center"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Legacy: overlay",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Legacy: overlay opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

{%- if section.blocks.size > 0 -%}
  {%- render 'section-spacing-collapsing' -%}

  <style>
    @media(max-width:768px){
       #shopify-section-{{ section.id }} {
      --multi-column-grid: {% if section.settings.stack_on_mobile %}none{% else %}auto / auto-flow 92vw{% endif %}!important;
      --multi-column-list-gap: {% if section.settings.gap == 'small' %}var(--grid-gutter){% elsif section.settings.gap == 'medium' %}var(--spacing-12){% elsif section.settings.gap == 'large' %}var(--spacing-20){% else %}var(--spacing-28){% endif %};
    }
    }
    #shopify-section-{{ section.id }} {
      --multi-column-grid: {% if section.settings.stack_on_mobile %}none{% else %}auto / auto-flow 73vw{% endif %};
      --multi-column-list-gap: {% if section.settings.gap == 'small' %}var(--grid-gutter){% elsif section.settings.gap == 'medium' %}var(--spacing-12){% elsif section.settings.gap == 'large' %}var(--spacing-20){% else %}var(--spacing-28){% endif %};
    }
    #shopify-section-{{ section.id }} .image_title_wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
}
 #shopify-section-{{ section.id }} .image_title_wrapper img {
    width: 50px;
    height: 50px;
}
.bottom_title_wrapper {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
}
.right_title3{
  color:{{ section.settings.right_title_text_color }};
}
.prg_bar_top_text {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}
{% for block in section.blocks %}
#shopify-section-{{ section.id }} .progress.progress-striped {
	overflow: hidden;
	height: 5px;
	background-color: {{block.settings.bar_bg}};
	border-radius: 4px;
	-webkit-box-shadow: inset 0 1px 2px rgba(0,0,0,.1);
	box-shadow: inset 0 1px 2px rgba(0,0,0,.1);
		margin-bottom: 20px;
}
#shopify-section-{{ section.id }} .progress-bar {
	width: 0;
	height: 100%;
	color: #fff;
	text-align: center;
	
}
#shopify-section-{{ section.id }} .progress-striped .progress-bar {
			background: {{block.settings.active_bar_bg}};
}
{% endfor %}
#shopify-section-{{ section.id }} .multi-column__item {

    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    padding: 15px;
        margin-bottom: 10px;
}
  </style>

  <div {% render 'section-properties' %}>
    <div class="section-stack">
      {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, content: section.settings.content, text_alignment: section.settings.text_alignment -%}

      <div class="multi-column scroll-area bleed md:unbleed">
        {%- for block in section.blocks -%}
          {%- liquid
            assign loading_strategy = nil
  
            if section.index > 3 or forloop.index > 3
              assign loading_strategy = 'lazy'
            endif
          -%}

          {%- case block.type -%}
            {%- when 'item' -%}
              <div class="multi-column__item justify-{{ section.settings.text_alignment }} snap-start" style="--multi-column-item-column-count: span {{ 12.0 | divided_by: block.settings.column_size | round }}" {{ block.shopify_attributes }}>
               <div class="image_title_wrapper">
                {%- if block.settings.video != blank -%}
                  <video-media autoplay style="--aspect-ratio: {{ block.settings.video.aspect_ratio }}">
                    {{ block.settings.video | video_tag: playsinline: true, muted: true, controls: block.settings.show_controls, loop: true, preload: 'metadata', class: 'rounded' }}
                  </video-media>
                {%- elsif block.settings.image != blank -%}
                  {%- capture sizes -%}(max-width: 699px) calc(73vw - 40px), (max-width: 999px) calc(38vw - 64px), calc(min({{ settings.page_width }}px, 100vw) / {{ block.settings.column_size }}){%- endcapture -%}
                  {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'rounded' -}}
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                      <p class="{{ block.settings.heading_tag }}">{{ block.settings.title | escape }}</p>
                    {%- endif -%}
            </div>
                {%- if block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank -%}
                  <div class="v-stack gap-4 text-{{ section.settings.text_alignment }}">
                    

                    {%- if block.settings.content != blank or block.settings.link_text != blank -%}
                      <div class="prose">
                        {{- block.settings.content -}}

                        
                          <div>
                            {%- if block.settings.link_style == 'link' -%}
                              <a href="{{ block.settings.link_url }}" class="link">{{ block.settings.link_text | escape }}</a>
                            {%- else -%}
                              {%- render 'button', href: block.settings.link_url, content: block.settings.link_text, size: 'lg' -%}
                            {%- endif -%}
                          </div>
                          <div class="bottom_title_wrapper">
                              {%- if block.settings.left_title2 != blank -%}
                                <p class="{{ block.settings.heading_tag2 }} left_title2">{{ block.settings.left_title2 | escape }}</p>
                              {%- endif -%}
                              {%- if block.settings.right_title3 != blank -%}
                                <p class="{{ block.settings.heading_tag2 }} right_title3">{{ block.settings.right_title3 | escape }}</p>
                              {%- endif -%}
                          </div>
                          <div class="progress_bar_text_wrapper">
                          <div class="prg_bar_top_text">
                            <span class="left_text">{{ block.settings.left_text }}</span>
                            <span class="right_text">{{ block.settings.right_text }}</span>
                          </div>
                          {% if section.settings.show_progressbar %}
                        <div class="custom_bar progress progress-striped">
                          
                            <div class="progress-bar progress-bar-danger" role="progressbar" aria-valuenow="{{block.settings.right_text}}" aria-valuemin="0" aria-valuemax="100" 
                              style="width:{{block.settings.right_text}}">
                            </div>
                        </div>
                       {% endif %}
                     </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'spacer' -%}
              <div class="multi-column__item hidden md:block" style="--multi-column-item-column-count: span {{ 12.0 | divided_by: block.settings.column_size | round }}" {{ block.shopify_attributes }}></div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}


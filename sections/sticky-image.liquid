         <script>
document.addEventListener('DOMContentLoaded', function() {
  const sticky = document.querySelector('.Sticky-img-wrapper');
  const sound = new Audio('https://cdn.shopify.com/s/files/1/0712/0194/7840/files/Sparkling_Chime_Sound_-_Meinl_Sonic_Energy.mp3?v=1764593601');
  if (!sticky) return;

  function moveSticky() {
    sticky.style.opacity = 0; // fade-out
   
    setTimeout(() => {
      const maxX = window.innerWidth - sticky.offsetWidth;
      const maxY = window.innerHeight - sticky.offsetHeight;

      const newX = Math.random() * maxX;
      const newY = Math.random() * maxY;

      sticky.style.left = `${newX}px`;
      sticky.style.top = `${newY}px`;

      sticky.style.opacity = 1; // fade-in again
      sound.currentTime = 0;
      sound.play(); 
    }, 3000);
  }

  moveSticky(); // initial random place
  setInterval(moveSticky, 10000); // repeat every 10 seconds
});
</script> {% endcomment %}


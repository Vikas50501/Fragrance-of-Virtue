/* Floating Sticky Image / Video */
.sticky-float-img,
.sticky-float-video {
  position: fixed;
  width: {{ section.settings.icon_width }}px;
  z-index: 998;
  pointer-events: auto;
  cursor: pointer;
}
{% endstyle %}

{% if section.settings.only_homepage and request.page_type == 'index' %}
  {% capture sticky_data %}
    {% if section.settings.sticky_img %}
      <img class="sticky-float-img" src="{{ section.settings.sticky_img | image_url }}" alt="Sticky Image">
    {% endif %}

    {% if section.settings.video %}
      {{ section.settings.video | video_tag: playsinline: true, muted: true, autoplay: true, controls: section.settings.show_controls, loop: true, preload: 'metadata', class: 'sticky-float-video' }}
    {% endif %}
  {% endcapture %}

  {% if section.settings.sticky_img or section.settings.video %}
    {% if section.settings.url != blank %}
      <a href="{{ section.settings.url }}" target="_blank">
        {{ sticky_data }}
      </a>
    {% else %}
      {{ sticky_data }}
    {% endif %}
  {% endif %}

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const img = document.querySelector('.sticky-float-img') || document.querySelector('.sticky-float-video');
    if (!img) return;

    // Random initial position
    let x = Math.random() * (window.innerWidth - img.offsetWidth);
    let y = Math.random() * (window.innerHeight - img.offsetHeight);

    // Slower speed (0.5px to 1.5px per frame)
    let dx = (Math.random() < 0.5 ? -1 : 1) * (0.5 + Math.random());
    let dy = (Math.random() < 0.5 ? -1 : 1) * (0.5 + Math.random());

    let isPaused = false;

    img.style.left = x + 'px';
    img.style.top = y + 'px';

    img.addEventListener('mouseenter', () => isPaused = true);
    img.addEventListener('mouseleave', () => isPaused = false);

    function move() {
      if (!isPaused) {
        x += dx;
        y += dy;

        // Bounce off edges
        if (x <= 0 || x + img.offsetWidth >= window.innerWidth) {
          dx = -dx;
          x = Math.max(0, Math.min(x, window.innerWidth - img.offsetWidth));
        }
        if (y <= 0 || y + img.offsetHeight >= window.innerHeight) {
          dy = -dy;
          y = Math.max(0, Math.min(y, window.innerHeight - img.offsetHeight));
        }

        img.style.left = x + 'px';
        img.style.top = y + 'px';
      }

      requestAnimationFrame(move);
    }

    move();

    window.addEventListener('resize', () => {
      x = Math.min(x, window.innerWidth - img.offsetWidth);
      y = Math.min(y, window.innerHeight - img.offsetHeight);
    });
  });
  </script>
{% endif %}



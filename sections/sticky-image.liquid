  .Sticky-img-wrapper {
    position: fixed;
    bottom:0;
    left: {{ section.settings.left_position }}%;
    border-radius: 10px 0 0 10px;
    overflow: hidden;
    z-index: 998;
       transition: opacity 0.6s ease-in-out;
    opacity: 1;
  }
  .Sticky-img-wrapper .sticky__image{
    width: {{ section.settings.icon_width }}px;
  }

  .sticky_content_wrapper {
    display: flex;
    align-items: center;
    position:relative;
  }
  .sticky_text{
    position: absolute;
    display: inline-block;
    font-size: 0.8rem;
    /* height: 0.5rem; */
    line-height: 0.8rem;
    vertical-align: bottom;
    /* overflow: hidden; */
    color: #000000;
    top: 25px;
    right: 28px;
    width: 100px;
  }
  @media(max-width:768px){
    .sticky_text{
      position: absolute;
      top:20px;
      right:18px;
      width:85px;
    }
  }

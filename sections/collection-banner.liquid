{%- assign show_image = false -%}

{%- if section.settings.show_collection_image and collection.image or section.settings.image -%}
  {%- assign show_image = true -%}
{%- endif -%}

{%- capture collection_header -%}
  {%- if section.settings.subheading != blank -%}
    <p class="cb-subheading">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}

  {%- if section.settings.show_collection_title -%}
    <h1 class="cb-title {{ section.settings.collection_title_size }}" {% if settings.heading_apparition != 'none' and show_image %}reveal-on-scroll="true"{% endif %}>
      {%- render 'styled-text', content: collection.title, apparition_effect: true -%}
    </h1>
  {%- endif -%}

  {%- if section.settings.show_collection_description and collection.description != blank -%}
    <div class="prose cb-description">
      {{- collection.description -}}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if show_image -%}
  <style>
    /* ── Banner height ── */
    {%- if section.settings.banner_height == 'small' -%}
      #shopify-section-{{ section.id }} .collection-banner {
        height: clamp(200px, 30vw, 340px) !important;
        min-height: unset !important;
      }
    {%- elsif section.settings.banner_height == 'medium' -%}
      #shopify-section-{{ section.id }} .collection-banner {
        height: clamp(280px, 38vw, 460px) !important;
        min-height: unset !important;
      }
    {%- elsif section.settings.banner_height == 'large' -%}
      #shopify-section-{{ section.id }} .collection-banner {
        height: clamp(360px, 46vw, 580px) !important;
        min-height: unset !important;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .collection-banner {
        height: clamp(280px, 38vw, 460px) !important;
        min-height: unset !important;
      }
    {%- endif -%}

    /* Mobile height */
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .collection-banner {
        height: clamp(200px, 55vw, 300px) !important;
        min-height: unset !important;
      }
    }

    /* ── Image fit ── */
    #shopify-section-{{ section.id }} .collection-banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    /* ── Section spacing ── */
    #shopify-section-{{ section.id }} {
      {%- if section.settings.full_width -%}
        --section-outer-spacing-block: 0;
      {%- else -%}
        --section-spacing-block-end: 0;
      {%- endif -%}
      {%- if section.settings.allow_transparent_header -%}
        margin-block-start: calc(-1 * var(--header-height) * var(--section-is-first));
      {%- endif -%}
    }

    {%- unless section.settings.full_width -%}
      .shopify-section:first-child .section[allow-transparent-header] {
        padding-block-start: max(var(--section-inner-max-spacing-block), var(--header-height));
      }
    {%- endunless -%}

    /* ── Overlay: override the theme's ::before directly ── */
    #shopify-section-{{ section.id }} .collection-banner::before {
      {%- if section.settings.gradient_overlay -%}
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.75) 0%,
        rgba(0, 0, 0, 0.35) 45%,
        rgba({{ section.settings.overlay_color.rgb }}, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 100%
      ) !important;
      {%- else -%}
      background: rgba({{ section.settings.overlay_color.rgb }}, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) !important;
      {%- endif -%}
      opacity: 1 !important;
    }

    /* ── Content text styles ── */
    #shopify-section-{{ section.id }} .cb-title {
      {%- if section.settings.text_shadow -%}
        text-shadow: 0 2px 20px rgba(0,0,0,0.55), 0 1px 5px rgba(0,0,0,0.45);
      {%- endif -%}
      font-family: var(--heading-font-family);
      font-size: clamp(26px, 3.8vw, 52px);
      font-weight: var(--heading-font-weight);
      letter-spacing: 1.5px;
      line-height: 1.1;
      margin: 0;
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .cb-title {
        font-size: clamp(22px, 7.5vw, 34px);
        letter-spacing: 0.5px;
      }
    }

    #shopify-section-{{ section.id }} .cb-subheading {
      font-family: var(--text-font-family);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      opacity: 0.85;
      margin: 0 0 12px;
      {%- if section.settings.text_shadow -%}
        text-shadow: 0 1px 8px rgba(0,0,0,0.5);
      {%- endif -%}
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .cb-subheading {
        font-size: 10px;
        letter-spacing: 2px;
        margin-bottom: 8px;
      }
    }

    #shopify-section-{{ section.id }} .cb-description {
      font-size: 14px;
      opacity: 0.88;
      max-width: 560px;
      line-height: 1.6;
      margin-top: 12px;
      {%- if section.settings.text_shadow -%}
        text-shadow: 0 1px 6px rgba(0,0,0,0.4);
      {%- endif -%}
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .cb-description {
        font-size: 12.5px;
        margin-top: 8px;
        display: none;
      }
    }

    /* ── Remove excess top/bottom margin ── */
    #shopify-section-{{ section.id }} .section {
      padding-block-start: 0 !important;
      padding-block-end: 0 !important;
    }
  </style>

  <div {% render 'section-properties' %} {%- if section.settings.allow_transparent_header -%}allow-transparent-header{% endif %}>
    {%- capture class -%}collection-banner content-over-media {% if section.settings.full_width %}full-bleed{% else %}shadow-block rounded-lg{% endif %}{%- endcapture -%}

    <image-banner reveal-on-scroll="true" {% if section.settings.enable_parallax %}parallax="0.3"{% endif %} {% render 'surface', class: class, text_color: section.settings.text_color %}>
      {%- assign desktop_image = section.settings.image | default: collection.image -%}
      {%- capture default_size -%}{% if section.settings.enable_parallax %}130vw{% else %}100vw{% endif %}{%- endcapture -%}
      {%- capture sizes -%}{% if section.settings.full_width %}{{ default_size }}{% else %}(max-width: 740px) calc({{ default_size }} - 40px), (max-width: 999px) calc({{ default_size }} - 64px), min({{ settings.page_width | times: 1.3 }}px, {{ default_size }} - 96px){% endif %}{%- endcapture -%}

      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 699px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 400 }} 400w, {{ section.settings.mobile_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_image | image_url: width: 800 }} 800w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
          >
        {%- endif -%}

        {{- desktop_image | image_url: width: desktop_image.width | image_tag: fetchpriority: 'high', sizes: sizes, widths: '400,600,800,1000,1200,1400,1600,1800,2000,2400,2800' -}}
      </picture>

      {%- if collection_header != blank -%}
        <div class="{{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
          <div class="v-stack gap-4 sm:gap-5">
            {{- collection_header -}}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.featured_product != blank -%}
        {%- if section.settings.desktop_text_position contains 'center-end' or section.settings.desktop_text_position contains 'start-end' -%}
          {%- assign featured_product_position = 'place-self-end-start' -%}
        {%- else -%}
          {%- assign featured_product_position = 'place-self-end' -%}
        {%- endif -%}

        <div class="{{ featured_product_position }} hidden md:block">
          <div class="collection-featured-product">
            {%- if section.settings.featured_product_heading != blank -%}
              <p class="collection-featured-product__title text-xs bold">{{ section.settings.featured_product_heading | escape }}</p>
            {%- endif -%}

            <a href="{{ section.settings.featured_product.url }}" class="collection-featured-product__content">
              {%- render 'horizontal-product', product: section.settings.featured_product, size: 'sm', output_link: false -%}
            </a>
          </div>
        </div>
      {%- endif -%}
    </image-banner>
  </div>
{%- else -%}
  {%- if collection_header != blank -%}
    <div class="collection-header">
      <div class="container">
        <div class="v-stack gap-4 sm:gap-6">
          {{- collection_header -}}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection banner",
  "class": "shopify-section--collection-banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        {
          "value": "small",
          "label": "Small (200–340px)"
        },
        {
          "value": "medium",
          "label": "Medium (280–460px)"
        },
        {
          "value": "large",
          "label": "Large (360–580px)"
        }
      ],
      "default": "medium",
      "info": "Controls the banner height across screen sizes. Mobile always shows a compact version."
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable parallax effect",
      "info": "Parallax effect slightly crops image edges.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "Allow transparent header",
      "info": "Only applies when this is the first section.",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "1600 x 600px .jpg recommended. Defaults to collection image."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "800 x 500px .jpg recommended. Defaults to desktop image."
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Use collection image as fallback",
      "info": "Uses the collection image when no custom image is set.",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "gradient_overlay",
      "label": "Add gradient overlay",
      "info": "Dark gradient from bottom to top for better text readability.",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Small text shown above the collection title (e.g. 'Award Winning')"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "select",
      "id": "collection_title_size",
      "label": "Collection title size",
      "options": [
        {
          "value": "h0",
          "label": "XX-Large"
        },
        {
          "value": "h1",
          "label": "X-Large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "text_shadow",
      "label": "Enable text shadow",
      "info": "Improves title readability over busy images.",
      "default": true
    },
    {
      "type": "header",
      "content": "Content position"
    },
    {
      "type": "select",
      "id": "mobile_text_position",
      "label": "Mobile content position",
      "options": [
        {
          "value": "place-self-start text-start",
          "label": "Top left"
        },
        {
          "value": "place-self-start-center text-center",
          "label": "Top center"
        },
        {
          "value": "place-self-center-start text-start",
          "label": "Middle left"
        },
        {
          "value": "place-self-center text-center",
          "label": "Middle center"
        },
        {
          "value": "place-self-end-start text-start",
          "label": "Bottom left"
        },
        {
          "value": "place-self-end-center text-center",
          "label": "Bottom center"
        }
      ],
      "default": "place-self-end-center text-center"
    },
    {
      "type": "select",
      "id": "desktop_text_position",
      "label": "Desktop content position",
      "options": [
        {
          "value": "sm:place-self-start sm:text-start",
          "label": "Top left"
        },
        {
          "value": "sm:place-self-start-center sm:text-center",
          "label": "Top center"
        },
        {
          "value": "sm:place-self-center-start sm:text-start",
          "label": "Middle left"
        },
        {
          "value": "sm:place-self-center sm:text-center",
          "label": "Middle center"
        },
        {
          "value": "sm:place-self-end-start sm:text-start",
          "label": "Bottom left"
        },
        {
          "value": "sm:place-self-end-center sm:text-center",
          "label": "Bottom center"
        }
      ],
      "default": "sm:place-self-end-center sm:text-center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Featured product",
      "info": "Only shown on desktop when a banner image is used."
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "featured_product_heading",
      "label": "Heading",
      "default": "Featured product"
    }
  ]
}
{% endschema %}

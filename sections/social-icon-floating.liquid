{% style %}
  .floating-social-icons-wrapper {
    position: fixed;
    {% case section.settings.sticky-positon %}
        {% when 'right' %}
            right: 0;
        {% when 'left' %}
            left: 0;
    {% endcase %}
    bottom: {{ section.settings.bottom_position }}%;
    width: {{ section.settings.icon_width }}px;
    border-radius: 10px 0 0 10px;
    overflow: hidden;
    z-index: 9999;
  }
  .floating-social-icons-wrapper ul.social-media {
    gap: 0;
  }
  .floating-social-icons-wrapper ul li{
    background: var(--bg-color);
  }
  .floating-social-icons-wrapper ul li a{
    text-align: center;
    width: {{ section.settings.icon_width }}px;
    display: flex;
    height: {{ section.settings.icon_width }}px;
    justify-content: center;
    align-items: center;
    color: {{ section.settings.text_color }};
  }
  .floating-social-icons-wrapper ul li a svg {
    width: 50%;
   }
  .floating-social-icons-wrapper ul li a.tap-area:before {
    content: "";
    inset: 0;
    position: relative;
  }
  @media screen and (max-width: 699px) {
    .floating-social-icons-wrapper {
      position: fixed;
      left:0;
      bottom: 0;
      width: 100%;
      border-radius: 10px 10px 0 0;
      overflow: hidden;
      z-index: 9999;
      /* height: 40px; */
      margin: -15px auto -7px auto;
    }
  
    .floating-social-icons-wrapper .social-media{
      display: grid;
      grid-template-columns: repeat(var(--social-count), 1fr);
    }
  .floating-social-icons-wrapper ul li a {
      text-align: center;
      width: 50px;
      height: 50px;
      margin: 0 auto;
  }
  .footer{
    --footer-social-icon-padding: 65px;
  }
    {% if template.name contains 'product' %}
      #shopify-section-{{ section.id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

<div class="floating-social-icons-wrapper">
    {%- render 'social-media-new', section: section -%}
</div>

{% schema %}

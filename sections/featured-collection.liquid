<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .premium-fc-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .premium-fc-header {
    text-align: center;
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .premium-fc-title {
    font-size: 2.2rem;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* --- GRID & CAROUSEL LAYOUT --- */
  .premium-fc-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.products_per_row_desktop }}, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  /* Mobile Carousel Setup */
  @media screen and (max-width: 768px) {
    .premium-fc-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 20px; /* Space for scrollbar */
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }
    
    .premium-fc-grid::-webkit-scrollbar {
      display: none; /* Chrome/Safari/Opera */
    }

    .premium-fc-item {
      flex: 0 0 calc((100% / {{ section.settings.products_per_row_mobile }}) - (16px * ({{ section.settings.products_per_row_mobile }} - 1) / {{ section.settings.products_per_row_mobile }}));
      scroll-snap-align: start;
    }
  }

  /* --- PRODUCT CARD STYLING --- */
  .premium-fc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.05);
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    text-decoration: none;
    position: relative;
  }

  .premium-fc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }

  .premium-fc-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .premium-fc-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .premium-fc-card:hover .premium-fc-image-wrapper img {
    transform: scale(1.06);
  }

  /* Badges */
  .premium-fc-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ section.settings.brand_color }};
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 4px;
    z-index: 2;
  }

  /* Info Section */
  .premium-fc-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: center;
  }

  .premium-fc-vendor {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #888;
    margin-bottom: 6px;
  }

  .premium-fc-product-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px 0;
    line-height: 1.4;
  }

  .premium-fc-price {
    font-size: 1.15rem;
    font-weight: 700;
    color: {{ section.settings.brand_color }};
    margin-bottom: 20px;
  }

  .premium-fc-price s {
    color: #999;
    font-size: 0.9rem;
    font-weight: 400;
    margin-left: 6px;
  }

  /* Add to Cart Form */
  .premium-fc-form {
    margin-top: auto;
    width: 100%;
  }

  .premium-fc-btn {
    width: 100%;
    background-color: {{ section.settings.brand_color }};
    color: #ffffff;
    border: none;
    padding: 12px 0;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .premium-fc-btn:hover {
    background-color: #a30e16;
  }

  .premium-fc-btn:disabled {
    background-color: #cccccc;
    cursor: not-allowed;
  }

  /* View All Button */
  .premium-fc-view-all {
    text-align: center;
    margin-top: 20px;
    display: block;
  }

  .premium-fc-view-all-btn {
    display: inline-block;
    padding: 14px 40px;
    border: 2px solid {{ section.settings.text_color }};
    color: {{ section.settings.text_color }};
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .premium-fc-view-all-btn:hover {
    background-color: {{ section.settings.text_color }};
    color: #ffffff;
  }
</style>

<div class="premium-fc-container">
  <div class="premium-fc-header">
    <h2 class="premium-fc-title">{{ section.settings.title }}</h2>
  </div>

  <div class="premium-fc-grid">
    {% assign collection = section.settings.collection %}
    
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 8 %}
        <div class="premium-fc-item">
          <div class="premium-fc-card">
            <a href="{{ product.url }}" class="premium-fc-image-wrapper">
              {% if product.compare_at_price > product.price %}
                <span class="premium-fc-badge">Sale</span>
              {% elsif product.available == false %}
                <span class="premium-fc-badge" style="background-color: #333;">Sold Out</span>
              {% endif %}
              
              <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy">
            </a>

            <div class="premium-fc-info">
              {% if section.settings.show_vendor %}
                <div class="premium-fc-vendor">{{ product.vendor }}</div>
              {% endif %}
              
              <a href="{{ product.url }}" style="text-decoration: none;">
                <h3 class="premium-fc-product-title">{{ product.title | truncate: 50 }}</h3>
              </a>
              
              <div class="premium-fc-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
              </div>

              <div class="premium-fc-form">
                {% if product.available %}
                  <form method="post" action="/cart/add" class="add-to-cart-form">
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                    <button type="submit" class="premium-fc-btn">Add to Cart</button>
                  </form>
                {% else %}
                  <button class="premium-fc-btn" disabled>Sold Out</button>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..8) %}
        <div class="premium-fc-item">
          <div class="premium-fc-card">
            <div class="premium-fc-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="premium-fc-info">
              <h3 class="premium-fc-product-title">Premium Incense {{ i }}</h3>
              <div class="premium-fc-price">₹ 140.00</div>
              <button class="premium-fc-btn">Add to Cart</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.show_view_all %}
    <div class="premium-fc-view-all">
      <a href="{{ section.settings.view_all_link | default: collection.url | default: '#' }}" class="premium-fc-view-all-btn">
        {{ section.settings.view_all_text }}
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Premium Featured Items",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Assign Collection",
      "info": "Desktop will show exactly 8 products from this collection."
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor/Brand Name",
      "default": true
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button Text",
      "default": "View All Collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link (Optional)",
      "info": "Leaves blank to automatically link to the assigned collection above."
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "products_per_row_desktop",
      "label": "Products per row (Desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (Mobile Carousel)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand Accent Color (Red)",
      "default": "#d1121c"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Premium Featured Items",
      "category": "Collection"
    }
  ]
}
{% endschema %}
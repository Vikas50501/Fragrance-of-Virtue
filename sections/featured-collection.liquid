<style>
  .premium-purpose-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .premium-purpose-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .premium-purpose-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .premium-purpose-header h2 {
    font-size: 2.2rem;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .premium-purpose-header p {
    font-size: 1rem;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
    max-width: 600px;
    margin: 0 auto;
  }

  /* Desktop Grid vs Mobile Swipe */
  .premium-purpose-grid {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 20px; /* Space for scrollbar */
    scrollbar-width: none; /* Firefox */
  }

  .premium-purpose-grid::-webkit-scrollbar {
    display: none; /* Safari/Chrome */
  }

  .premium-purpose-card {
    flex: 0 0 85%; /* Shows a peek of the next card on mobile */
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    group;
  }

  @media screen and (min-width: 768px) {
    .premium-purpose-grid {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
      overflow-x: visible;
      padding-bottom: 0;
    }
    .premium-purpose-card {
      flex: auto;
    }
  }

  .premium-purpose-image {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 2 / 3; /* Premium tall portrait ratio */
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
  }

  .premium-purpose-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .premium-purpose-card:hover .premium-purpose-image img {
    transform: scale(1.06);
  }

  .premium-purpose-content {
    text-align: center;
    padding: 0 10px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .premium-purpose-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 8px 0;
  }

  .premium-purpose-content p {
    font-size: 0.9rem;
    line-height: 1.5;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.8 }};
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  .premium-purpose-link {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    position: relative;
    display: inline-block;
    align-self: center;
    padding-bottom: 4px;
  }

  .premium-purpose-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: {{ section.settings.accent_color }};
    transform: scaleX(0.3);
    transition: transform 0.3s ease;
  }

  .premium-purpose-card:hover .premium-purpose-link::after {
    transform: scaleX(1);
  }
</style>

<div class="premium-purpose-{{ section.id }}">
  <div class="premium-purpose-container">
    
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="premium-purpose-header">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="premium-purpose-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link_url }}" class="premium-purpose-card" {{ block.shopify_attributes }}>
          <div class="premium-purpose-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          
          <div class="premium-purpose-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <span class="premium-purpose-link">{{ block.settings.link_text }}</span>
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Premium Purpose Cards",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Shop by Purpose"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subheading",
      "default": "Discover the perfect fragrance for every moment."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Links & Lines)",
      "default": "#d1121c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image",
          "info": "Use tall, high-quality images (e.g., 800x1200px)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pooja & Rituals"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Daily Pooja, Purification & cleansing, Devotional & Temple use."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Purpose Cards",
      "blocks": [
        { "type": "category", "settings": { "title": "Pooja & Rituals" } },
        { "type": "category", "settings": { "title": "Aromatherapy" } },
        { "type": "category", "settings": { "title": "Make Your Own Pack" } },
        { "type": "category", "settings": { "title": "Meditation" } },
        { "type": "category", "settings": { "title": "Wellness" } }
      ]
    }
  ]
}
{% endschema %}
{%- if section.settings.text != blank -%}
  {%- render 'section-spacing-collapsing' -%}

  <style>
    #shopify-section-{{ section.id }} span.scrolling-text__text {
        display: flex;
        padding: 0;
    }
    #shopify-section-{{ section.id }} {
      --section-spacing-inline: 0;
      --scrolling-text-font-size: {% if section.settings.text_size == 'xsmall' %}1.125rem{% elsif section.settings.text_size == 'small' %}2.5rem{% elsif section.settings.text_size == 'medium' %}3.75rem{% elsif section.settings.text_size == 'large' %}5rem{% else %}7.5rem{% endif %};
    }
    #shopify-section-{{ section.id }} span.scroll_content_wrapper {
      display: flex;
      gap: 20px;
      padding-right: 100px;
      align-items: center;
    }
    
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --scrolling-text-font-size: {% if section.settings.text_size == 'xsmall' %}1.5rem{% elsif section.settings.text_size == 'small' %}3.75rem{% elsif section.settings.text_size == 'medium' %}5rem{% elsif section.settings.text_size == 'large' %}8.75rem{% else %}12.5rem{% endif %};
      }
    }
    @media screen and (max-width:699px) {
     #shopify-section-{{ section.id }} span.scroll_content_wrapper {
      gap: 10px;
      padding-right: 50px;
      font-size:16px;
     }
     #shopify-section-{{ section.id }} .scroll_content_wrapper img{
         width: 15px;
     }
    }

    /* Premium SVG icons: consistent size, weight, alignment and spacing */
    #shopify-section-{{ section.id }} span.scroll_content_wrapper { gap: 0.5em; }
    #shopify-section-{{ section.id }} .luxe-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      line-height: 0;
      color: {% if section.settings.icon_color != blank %}{{ section.settings.icon_color }}{% elsif section.settings.text_color != blank %}{{ section.settings.text_color }}{% else %}currentColor{% endif %};
    }
    #shopify-section-{{ section.id }} .luxe-icon svg {
      width: 1.15em;
      height: 1.15em;
      display: block;
      overflow: visible;
    }
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} span.scroll_content_wrapper { gap: 0.5em; }
      #shopify-section-{{ section.id }} .luxe-icon svg { width: 1.1em; height: 1.1em; }
    }
  </style>

  {%- if section.settings.text_size == 'xsmall' -%}
    {%- assign is_tight = true -%}
  {%- endif -%}

  <div {% render 'section-properties', tight: is_tight %}>
    {%- capture block_content -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign icon_key = block.settings.icon_type | default: 'auto'
          if icon_key == 'auto'
            assign t = block.settings.text | downcase
            if t contains 'charcoal'
              assign icon_key = 'leaf'
            elsif t contains 'eco' or t contains 'sustain'
              assign icon_key = 'eco'
            elsif t contains 'fragrance' or t contains 'aroma' or t contains 'scent' or t contains 'perfume'
              assign icon_key = 'perfume'
            elsif t contains 'burn' or t contains 'incense' or t contains 'stick' or t contains 'smoke'
              assign icon_key = 'incense'
            elsif t contains 'award' or t contains 'winning' or t contains 'excellence'
              assign icon_key = 'award'
            elsif t contains 'legacy' or t contains '1961' or t contains 'heritage' or t contains 'since' or t contains 'tradition'
              assign icon_key = 'legacy'
            else
              assign icon_key = 'sparkle'
            endif
          endif
        -%}
        <span class="scroll_content_wrapper">
            {%- if block.settings.icon_type == 'image' and block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | image_url: width: 100 }}" loading="lazy" class="scroll_img" width="40" height="40" alt="">
            {%- elsif icon_key != 'none' -%}
              {%- render 'luxe-icon', icon: icon_key -%}
            {%- endif -%}
            <span class="scroll_txt">{{ block.settings.text }}</span>
          </span>
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture section_content -%}
      {%- for i in (1..10) -%}
        <span class="scrolling-text__text heading {% unless forloop.first %}motion-reduce:hidden{% endunless %}" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
          {%- render 'styled-text', content: block_content, gradient: section.settings.text_gradient, style: section.settings.text_style -%}
        </span>
      {%- endfor -%}
    {%- endcapture -%}

    <div class="scrolling-text {% if section.settings.scrolling_mode == 'scroll' %}scrolling-text--scroll{% else %}scrolling-text--auto{% endif %}">
      {%- if section.settings.scrolling_mode == 'scroll' -%}
        <scrolling-text class="scrolling-text__wrapper">
          {{- section_content -}}
        </scrolling-text>
       {%- else -%}
         <marquee-text scrolling-speed="{{ section.settings.scrolling_speed }}" class="scrolling-text__wrapper">
           {{- section_content -}}
         </marquee-text>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling icon with text",
  "class": "shopify-section--scrolling-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Promotion text"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "xsmall",
          "label": "X-Small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "X-Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "scrolling_mode",
      "label": "Scrolling mode",
      "options": [
        {
          "value": "auto",
          "label": "Automatic"
        },
        {
          "value": "scroll",
          "label": "On scroll"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "Automatic scrolling speed",
      "default": 10,
      "visible_if": "{{ section.settings.scrolling_mode == 'auto' }}"
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Gradient replaces solid colors when set. Gradient text outline and gradient background cannot be combined."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color_background",
      "id": "text_gradient",
      "label": "Text gradient"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "info": "Defaults to the text color."
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
          {
            "type": "select",
            "id": "icon_type",
            "label": "Icon",
            "info": "Premium built-in icons. Choose 'Auto' to match the text automatically.",
            "options": [
              { "value": "auto", "label": "Auto (match text)" },
              { "value": "leaf", "label": "Charcoal-free (leaf)" },
              { "value": "eco", "label": "Eco-friendly (sprout)" },
              { "value": "perfume", "label": "Fragrance (perfume)" },
              { "value": "incense", "label": "Incense (stick + smoke)" },
              { "value": "award", "label": "Award (medal)" },
              { "value": "legacy", "label": "Legacy (shield)" },
              { "value": "sparkle", "label": "Sparkle" },
              { "value": "image", "label": "Uploaded image" },
              { "value": "none", "label": "No icon" }
            ],
            "default": "auto"
          },
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Uploaded image",
            "info": "Used only when Icon is set to 'Uploaded image'. 100 x 100px recommended."
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Promotion text"
          }
      ]
    }
 ],
  "presets": [
    {
      "name": "Scrolling icon with text"
    }
  ]
}
{% endschema %}
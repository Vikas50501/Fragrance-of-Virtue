{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SOCIAL MEDIA
----------------------------------------------------------------------------------------------------------------------

Output a list of social media icons based on the social URL settings.

********************************************
Supported variables
********************************************

* size: can be "sm" or nothing. When setting is set to "sm", this only impacts the mobile (desktop uses the same size)
{%- endcomment -%}
 {% assign social_count = 0 %}

{%- capture social_media -%}
  {% if section.settings.custom_icon_link != blank %}
    <li style="--bg-color: {{ section.settings.custom_icon_bg_color }};">
      <a href="{{ section.settings.custom_icon_link }}" class="tap-area" rel="noopener" aria-label="Shop Now">
        {%- render 'icon' with 'home' -%}
      </a>
      {% assign social_count = social_count | plus: 1 %}
    </li>
  {% endif %}

  {%- if settings.social_facebook != blank or shop.brand.metafields.social_links.facebook != blank -%}
    <li style="--bg-color: {{ section.settings.fb_bg_color }};">
      <a href="{{ settings.social_facebook | default: shop.brand.metafields.social_links.facebook }}" class="tap-area" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: social_media: 'Facebook' }}">
        {%- render 'icon' with 'facebook' -%}
      </a>
      {% assign social_count = social_count | plus: 1 %}
    </li>
  {%- endif -%}

